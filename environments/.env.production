# Production – used when you run npm run build:prod (e.g. on Vercel)
# Backend API base URL (your deployed Laravel API, no trailing slash)
REACT_APP_API_BASE_URL=https://api.coestudycenter.com.ng/api

# Backup DB API — required for clearance + exam card (2024/2025 fee checks)
REACT_APP_BACKUP_API_BASE_URL=https://utmeapi.coestudycenter.com.ng/api

# Paystack public key – use LIVE key in production
REACT_APP_PAYSTACK_PUBLIC_KEY=pk_live_a0e748b1c573eab4ee5c659fe004596ecd25a232

# Enable split payments in production
REACT_APP_ENABLE_SPLITS=true
